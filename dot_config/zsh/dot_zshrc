# =================== zshrc ===================
# Interactive zsh config. Sourced for interactive shells only.
#
# Load order (matters!):
#   1. options                 (this file; EXTENDED_GLOB before compinit)
#   2. compinit                (this file, cached daily at $ZDOTDIR/.zcompdump)
#   3. config files            (aliases, exports, vi-mode, tools)
#   4. fzf-tab plugin          (must come after compinit, before fzf keybindings)
#   5. fzf keybindings         (this file, after the config block)
#   6. direnv hook             (this file, after compinit)
#   7. zoxide init             (this file)
#   8. atuin init              (must be LAST so it can override Ctrl+R)
#   9. zsh-syntax-highlighting (last in tools.zsh, to bind all widgets)

# --- Options -----------------------------------------------------------------
# Set before compinit: the compdump freshness check below uses (#q...) glob
# qualifiers, which require EXTENDED_GLOB.
setopt EXTENDED_GLOB        # #~^ patterns and (#q...) qualifiers
setopt AUTO_CD              # cd by typing dir name
setopt CORRECT              # try to correct typos
setopt CORRECT_ALL          # correct arguments too
setopt INTERACTIVE_COMMENTS # # comments in interactive
setopt NO_CASE_GLOB         # case-insensitive globbing
setopt SHARE_HISTORY        # share between sessions
setopt APPEND_HISTORY       # append, don't overwrite
setopt INC_APPEND_HISTORY   # write immediately
setopt HIST_IGNORE_DUPS     # ignore consecutive duplicates
setopt HIST_IGNORE_SPACE    # ignore lines starting with space
setopt HIST_SAVE_NO_DUPS    # don't re-save entries already in the file
setopt HIST_VERIFY          # show before executing from history
setopt PROMPT_SUBST
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_TO_HOME
setopt MAGIC_EQUAL_SUBST    # completion after =

HISTSIZE=100000             # in-memory history (default is 30 in some builds)
SAVEHIST=50000              # on-disk history (~/.config/zsh/.zsh_history)

# --- Completion system -------------------------------------------------------
autoload -Uz compinit
zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
# Rebuild the dump at most once a day; reuse it with -C (skips the insecure
# directory check). Use -u when rebuilding so Homebrew's dirs don't prompt.
if [[ -n ${zcompdump}(#qN.mh+24) ]]; then
  compinit -C -d "$zcompdump"
else
  compinit -u -d "$zcompdump"
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches --%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

# --- Source user config files ------------------------------------------------
ZSH_CONFIG_DIR="$XDG_CONFIG_HOME/zsh"

for f in \
  aliases.zsh \
  exports.zsh \
  vi-mode.zsh \
  tools.zsh \
  prompt.zsh
do
  [[ -f "$ZSH_CONFIG_DIR/$f" ]] && source "$ZSH_CONFIG_DIR/$f"
done

# --- fzf-tab plugin (BEFORE fzf key-bindings, AFTER compinit) ----------------
# https://github.com/Aloxaf/fzf-tab
for plugin in \
  /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh \
  /usr/share/zsh/plugins/fzf-tab/fzf-tab.zsh \
  /opt/homebrew/share/fzf-tab/fzf-tab.plugin.zsh \
  $HOME/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
do
  [[ -f $plugin ]] && source $plugin && break
done

# Source the fzf-tab UI config
[[ -f $ZSH_CONFIG_DIR/fzf-tab.zsh ]] && source $ZSH_CONFIG_DIR/fzf-tab.zsh

# --- fzf keybindings (after fzf-tab, before atuin) ---------------------------
if command -v fzf >/dev/null; then
  source <(fzf --zsh) 2>/dev/null \
    || source /usr/share/fzf/key-bindings.zsh 2>/dev/null \
    || source /opt/homebrew/opt/fzf/shell/key-bindings.zsh 2>/dev/null
fi

# --- direnv: per-project env vars (after compinit) ---------------------------
if command -v direnv >/dev/null; then
  eval "$(direnv hook zsh)"
fi

# --- zoxide (smarter cd) -----------------------------------------------------
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
  # zoxide only records directories you cd into. Register the directory this
  # shell starts in so Herdr panes/tabs, `herdr worktree create`, and fresh
  # clones are immediately reachable with `z`.
  zoxide add -- "$PWD" 2>/dev/null || true
fi

# --- Atuin (MUST BE LAST — replaces Ctrl+R) ----------------------------------
# https://atuin.sh — encrypted, searchable shell history
if command -v atuin >/dev/null; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# --- Local overrides ---------------------------------------------------------
# Machine-specific zsh settings (NOT in git)
[[ -f ${ZDOTDIR:-$HOME}/.zshrc.local ]] && source ${ZDOTDIR:-$HOME}/.zshrc.local
